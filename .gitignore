# ── Unrelated sibling directories in this workspace ─────────────────
# (the rabbit_hole/ dir hosts other projects; keep them out of this repo)
.data/
Repos/
cc_workspace/

# ── Project artifacts ────────────────────────────────────────────────
# Audio corpora downloaded from AudioSet / Zenodo / etc. (hundreds of MB)
data/
# Detector runtime output. Patterns without trailing slash match both
# real directories and symlinks (e.g. when these dirs are symlinked into
# Dropbox for backup).
logs
howl_recordings
logs_*.txt
# Cached embeddings (large npz)
*.npz
# Local env overrides
.env

# ── Python / uv ──────────────────────────────────────────────────────
# Note: uv.lock IS committed (this is an application repo, not a library)
# for reproducible installs via `uv sync`.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ruff_cache/
.pytest_cache/

