# Cat-Howl Detector — example configuration.
# Copy to `.env` (which is gitignored) and edit for your machine.
# All values are optional; defaults are listed in brackets [].

# ── Inference backend ─────────────────────────────────────────────────────
#   cpu    — CPU via TensorFlow. Recommended on M-series Macs — YAMNet
#            warm inference is ~2 ms (240× headroom over the 480 ms hop).
#   mps    — Apple GPU via tensorflow-metal. Requires tensorflow-metal,
#            and TF must be in the 2.16–2.18 range it supports.
#   cuda   — NVIDIA GPU via TensorFlow. Linux + CUDA only.
#   coreml — Apple Neural Engine via Core ML. NOTE: blocked at the
#            framework level because YAMNet's mel-spectrogram uses ops
#            (ComplexAbs) that coremltools doesn't implement.
BACKEND=cpu

# ── Detection behavior ────────────────────────────────────────────────────
# If 1, log triggers but do NOT play the ultrasonic deterrent. Recommended
# for the first day to audit detections before turning the speaker on. [0]
LOG_ONLY=1

# If 1, save pre/post-roll WAV clips of every detection (including gated
# ones, tagged "_gated") to ./howl_recordings/ for fine-tuning data. [0]
RECORD_HOWLS=1

# Minimum seconds between consecutive deterrent triggers. Drop this lower
# (e.g. 5–10) for denser data collection; keep at 30+ for actual
# deterrent use (you don't want continuous bursts). [30]
COOLDOWN_SECONDS=10

# ── Deterrent tone ────────────────────────────────────────────────────────
# Length of each ultrasonic burst (seconds). [3.0]
DETERRENT_SECONDS=3.0

# ── Microphone ────────────────────────────────────────────────────────────
# Int index OR substring of the input device name (sounddevice's list).
# Examples: "Yeti", "MacBook Pro Microphone", "5". Leave unset for default.
MIC_DEVICE=Yeti

# "sd" — sounddevice/PortAudio (default, fast). Hangs silently if
#         coreaudiod is wedged; use fix_audio_and_start.sh to recover.
# "ffmpeg" — ffmpeg/AVFoundation subprocess. Useful fallback on macOS
#         if PortAudio misbehaves. ffmpeg needs its own TCC permission.
MIC_BACKEND=sd

# ── Howl-recording tuning ─────────────────────────────────────────────────
# Seconds of audio retained BEFORE each trigger. [3.0]
HOWL_PRE_SECONDS=3.0

# Minimum post-roll regardless of whether the cat keeps vocalizing. [2.0]
HOWL_POST_MIN_SECONDS=2.0

# Capture ends after this much continuous below-threshold audio,
# AFTER the minimum post-roll has elapsed. [2.0]
HOWL_TAIL_SECONDS=2.0

# Hard ceiling on total post-roll length (safety net for false-positive
# lock-ins on noisy environments). [20.0]
HOWL_MAX_SECONDS=20.0

# Cat-class score above which the post-roll keeps extending. Lower =
# more permissive (record more), higher = tighter clips. [0.3]
HOWL_EXTEND_THRESHOLD=0.3
