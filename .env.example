# Copy to .env (or `export` them) to configure the detector.

# Inference backend.
#   coreml — Apple Neural Engine (Mac M-series, lowest power, recommended for 24/7)
#   mps    — Apple GPU via tensorflow-metal (Mac, no CoreML conversion needed)
#   cuda   — NVIDIA GPU via TensorFlow (Linux + CUDA)
#   cpu    — CPU via TensorFlow (default, works everywhere)
BACKEND=coreml

# If 1, run the detector + log triggers but DO NOT emit the deterrent tone.
# Use this the first night to audit detections before letting the tone fire.
LOG_ONLY=0

# Length of each deterrent burst in seconds. Frequencies are randomized
# pulse-by-pulse within the 22–24 kHz band (see TONE_FREQ_LOW_HZ /
# TONE_FREQ_HIGH_HZ inside cat_howl_deterrent.py to change the band itself).
DETERRENT_SECONDS=3.0
